{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug z21emu (config in /www/config)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/z21/src/z21emu",
      "args": ["-g", "192.168.20.79", "-c", "/www/config/config", "-f", "-x"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/z21/src",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "targetArchitecture": "arm64",
      "setupCommands": [
        { "description": "Enable pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "description": "Follow parent after fork/vfork", "text": "set follow-fork-mode parent", "ignoreFailures": true },
        { "description": "Detach from child on fork", "text": "set detach-on-fork on", "ignoreFailures": true }
      ],
      "preLaunchTask": "z21: Build all"
    },
    {
      "name": "Debug cs2toz21 (local /www/config)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/z21/src/cs2toz21",
      "args": ["-c", "/www/config", "-f", "1000", "-v"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/z21/src",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "targetArchitecture": "arm64",
      "setupCommands": [
        { "description": "Enable pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "description": "Follow parent after fork/vfork", "text": "set follow-fork-mode parent", "ignoreFailures": true },
        { "description": "Detach from child on fork", "text": "set detach-on-fork on", "ignoreFailures": true }
      ],
      "preLaunchTask": "z21: Build all"
    },
    {
      "name": "Debug cs2toz21 (auto network)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/z21/src/cs2toz21",
      "args": ["-v", "-a", "10", "-i", "lo"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/z21/src",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "targetArchitecture": "arm64",
      "setupCommands": [
        { "description": "Enable pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "description": "Follow parent after fork/vfork", "text": "set follow-fork-mode parent", "ignoreFailures": true },
        { "description": "Detach from child on fork", "text": "set detach-on-fork on", "ignoreFailures": true }
      ],
      "preLaunchTask": "z21: Build all"
    }
  ]
}
