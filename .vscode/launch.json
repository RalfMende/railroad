{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug z21emu (config in /www/config)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/z21/src/z21emu",
      "args": ["-g", "192.168.20.79", "-c", "/www/config/config", "-f", "-x"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/z21/src",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "Enable pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "description": "Follow child on fork", "text": "set follow-fork-mode child", "ignoreFailures": true },
        { "description": "Do not detach on fork", "text": "set detach-on-fork off", "ignoreFailures": true }
      ],
      "preLaunchTask": "z21: Build all"
    },
    {
      "name": "Debug cs2toz21",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/z21/src/cs2toz21",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/z21/src",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "z21: Build all"
    }
  ]
}
