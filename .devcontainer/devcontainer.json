{
  "name": "Ubuntu 22.04 - C/C++",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",
    "-p",
    "21105:21105/udp",
    "-p",
    "21106:21106/udp"
  ],
  "mounts": [
    "source=/Users/ralf/Documents/github/backup_config/,target=/www/config/,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools"
      ]
    }
  },
  "postCreateCommand": "ldconfig || true && mkdir -p /www/config"
}
